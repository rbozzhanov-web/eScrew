# AIMS Configuration
AIMS_BASE_URL=https://aims.airastana.com
AIMS_USERNAME=your_username_here
AIMS_PASSWORD=your_password_here

# Redis
REDIS_URL=redis://localhost:6379
REDIS_SESSION_TTL=1500

# Logging
LOG_LEVEL=INFO
LOG_FILE=parser.log

# Request Settings
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2

# Rate Limiting
RATE_LIMIT_DELAY=1.0
RATE_LIMIT_MAX_PER_MINUTE=3

# Browser (Selenium)
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=10
USE_BROWSER_FOR_JS_CONTENT=true

# AWS (optional)
AWS_REGION=eu-west-1

# Vault (optional)
VAULT_ADDR=
VAULT_TOKEN=

# Application
APP_NAME=AIMS eCrew Parser
APP_VERSION=1.0.0
DEBUG=false
