{
  "expo": {
    "name": "eScrew",
    "slug": "escrew",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "escrew",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "eScrew — Crew Schedule",
      "shortName": "eScrew",
      "themeColor": "#2D7DFF",
      "backgroundColor": "#F6F7FA",
      "display": "standalone"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/eScrew"
    }
  }
}
