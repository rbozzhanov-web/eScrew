{
  "name": "escrew",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "EXPO_PUBLIC_ESCREW_BUILT_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ) expo export --platform web --output-dir dist && node scripts/make-sw.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.12",
    "expo": "~57.0.15",
    "expo-document-picker": "~57.0.1",
    "expo-router": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
